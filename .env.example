# Copy this file to `.env.local` and adjust for your machine.
#
# Every variable here is inlined into the JavaScript bundle at build time and is readable by anyone
# who installs the app. Never put a secret in an EXPO_PUBLIC_ variable.
# https://docs.expo.dev/guides/environment-variables/
#
# Each variable must also be declared in `lib/env.ts`, which validates them at startup.

# Which deployment this bundle targets: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Absolute base URL of the backend API, no trailing slash.
# Optional in development (defaults to http://localhost:3000); required otherwise.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Minimum log level to emit: debug | info | warn | error | silent
# Defaults to debug in development and info elsewhere.
EXPO_PUBLIC_LOG_LEVEL=debug

# ---------------------------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------------------------
# Both values below are PUBLIC. They ship inside the app bundle and anyone who installs the app
# can read them. That is expected: the publishable key identifies the project and grants nothing
# on its own. Every permission comes from row-level security evaluated against the caller's
# session.
#
# NEVER put a privileged key here. The service_role key (or an `sb_secret_...` key) bypasses
# row-level security completely, and shipping one in a mobile bundle gives every installed copy
# of the app unrestricted access to every user's data. `lib/env.ts` refuses to start if it
# detects one in this variable, but the real defence is not pasting it in the first place.
#
# Find these in the Supabase dashboard under Project Settings > API.
# Optional in development (the app runs without them); required in staging and production.

# Project URL, e.g. https://<project-ref>.supabase.co
# For a local stack started with `supabase start`, use http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=

# The publishable client key (`sb_publishable_...`). Older projects issue an `anon` JWT instead;
# both are accepted.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
