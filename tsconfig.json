{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    // Beyond `strict`: these catch the classes of bug that survive a strict-mode migration.
    /** `array[i]` and `record[key]` are typed as possibly `undefined`, because they are. */
    "noUncheckedIndexedAccess": true,
    /** Optional properties cannot be assigned an explicit `undefined`, so intent stays visible. */
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /** Forces `import type` for type-only imports, which keeps them out of the runtime bundle. */
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["jest"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", ".expo"]
}
